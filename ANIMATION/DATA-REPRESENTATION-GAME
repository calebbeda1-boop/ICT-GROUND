// --- Racing engine ---
const raceState={score:0,races:0,best:0};
const saved=JSON.parse(localStorage.getItem("dr_racing_v3")||"{}");
Object.assign(raceState,saved);
let selectedMission=1, raceQuestions=[], raceIndex=0, mode=5;
let running=false, countdownDone=false, lastFrame=0, playerDist=0, aiDist=[0,0,0];
let speed=0, maxSpeed=0, combo=0, correct=0, answered=0, raceScore=0;
let qLocked=false, raceTimer=0, animId=0;

function saveRace(){localStorage.setItem("dr_racing_v3",JSON.stringify(raceState))}
function show(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));document.getElementById(id).classList.add("active")}
function showSetup(){
 renderMissionList(); show("setup");
}
function renderMissionList(){
 const box=document.getElementById("missionList"); box.innerHTML="";
 missions.forEach(m=>{
   const b=document.createElement("button"); b.className="mission-btn"+(m.id===selectedMission?" selected":"");
   b.innerHTML=`<b>${String(m.id).padStart(2,"0")} — ${m.title}</b><small>${m.desc}</small>`;
   b.onclick=()=>{selectedMission=m.id;renderMissionList()}; box.appendChild(b);
 });
}
function setMode(n){mode=n;document.getElementById("m5").classList.toggle("selected",n===5);document.getElementById("m10").classList.toggle("selected",n===10)}
function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function norm(v){return String(v??"").trim().toLowerCase().replace(/\s+/g,"")}
function pickQuestions(){
 let pool=Q[selectedMission]||[];
 let arr=shuffle(pool);
 // Add dedicated drag challenges so the racing game genuinely uses drag interaction.
 const dragBank=[
  {type:"drag",prompt:"Drag the binary place values into descending order (highest to lowest).",answer:["128","64","32","16","8","4","2","1"],items:["8","128","2","64","1","32","16","4"]},
  {type:"drag",prompt:"Drag the conversion steps into the correct order for converting a denary number to binary.",answer:["Choose largest place value","Subtract the place value if it fits","Continue with the remaining place values","Write 1 or 0 for each place value"],items:["Write 1 or 0 for each place value","Choose largest place value","Continue with the remaining place values","Subtract the place value if it fits"]},
  {type:"drag",prompt:"Drag the RLE process into the correct order.",answer:["Identify repeated items","Count each run","Write count followed by value","Check the encoded result"],items:["Check the encoded result","Count each run","Identify repeated items","Write count followed by value"]}
 ];
 if(!arr.some(x=>x.type==="drag")) arr.push(dragBank[(selectedMission-1)%dragBank.length]);
 return shuffle(arr).slice(0,mode);
}
function startRace(){
 raceQuestions=pickQuestions(); raceIndex=0; playerDist=0; aiDist=[0,0,0]; speed=0;maxSpeed=0;combo=0;correct=0;answered=0;raceScore=0;qLocked=false;raceTimer=0;running=true;
 document.getElementById("qnum").textContent=`1 / ${raceQuestions.length}`;
 document.getElementById("countdown").style.display="grid";
 show("race"); beginCountdown();
}
function beginCountdown(){
 let n=3; const c=document.getElementById("countdown"); c.textContent=n;
 const t=setInterval(()=>{n--; if(n>0)c.textContent=n; else if(n===0)c.textContent="GO"; else{clearInterval(t);c.style.display="none";countdownDone=true;lastFrame=performance.now();animId=requestAnimationFrame(loop);openQuestion();}},700);
}
function loop(now){
 if(!running)return;
 const dt=Math.min(.05,(now-lastFrame)/1000); lastFrame=now;
 if(countdownDone){
   // Speed is an abstract racing speed; correct answers determine acceleration.
   speed += (95-speed)*dt*.08;
   speed=Math.max(0,Math.min(260,speed));
   playerDist += speed*dt*.22;
   const aiBase=[146,157,168];
   for(let i=0;i<3;i++) aiDist[i]+=aiBase[i]*dt*.22*(0.94+Math.sin((raceTimer+i)*.7)*.025);
   raceTimer+=dt;
   updateVisual(dt);
   if(playerDist>=1000 || Math.max(...aiDist)>=1000){finishRace();return}
 }
 animId=requestAnimationFrame(loop);
}
function updateVisual(dt){
 document.getElementById("speed").textContent=Math.round(speed);
 const all=[playerDist,...aiDist].map((d,i)=>({d,i})).sort((a,b)=>b.d-a.d);
 const pos=all.findIndex(x=>x.i===0)+1; document.getElementById("position").textContent=`${pos} / 4`;
 document.getElementById("combo").textContent=combo;
 document.getElementById("raceProgress").style.width=Math.min(100,playerDist/10)+"%";
 maxSpeed=Math.max(maxSpeed,speed);
 // Camera/track motion.
 const road=document.getElementById("road");
 road.style.backgroundPosition=`0 ${-(playerDist*2.2)%110}px`;
 const wrapH=document.getElementById("trackwrap").clientHeight;
 const ids=["bikePlayer","bike1","bike2","bike3"];
 const ds=[playerDist,...aiDist];
 ds.forEach((d,i)=>{
   const lane=[50,27,61,76][i];
   const y=55+((d*2.2)%420);
   const el=document.getElementById(ids[i]); el.style.left=lane+"%"; el.style.bottom=Math.min(440,y)+"px";
 });
}
function openQuestion(){
 if(!running || raceIndex>=raceQuestions.length)return;
 qLocked=false;
 const q=raceQuestions[raceIndex], box=document.getElementById("questionBox");
 box.style.display="block";
 document.getElementById("qnum").textContent=`${raceIndex+1} / ${raceQuestions.length}`;
 if(q.type==="choice") renderChoice(q,box);
 else if(q.type==="text") renderText(q,box);
 else if(q.type==="bits") renderText(q,box);
 else if(q.type==="drag") renderDrag(q,box);
}
function renderChoice(q,box){
 box.innerHTML=`<div class="tag">CLICK CHALLENGE</div><h2>${q.prompt}</h2><div class="options">${shuffle(q.options).map((o,i)=>`<button class="option" onclick="answerChoice(this,${JSON.stringify(o)})">${o}</button>`).join("")}</div><div class="feedback" id="feedback"></div>`;
}
function renderText(q,box){
 box.innerHTML=`<div class="tag">TYPE CHALLENGE</div><h2>${q.prompt}</h2><div class="typebox"><input id="answerInput" autocomplete="off" autofocus placeholder="Type your answer..."><button class="btn" onclick="submitText()">ACCELERATE</button></div><div class="feedback" id="feedback"></div>`;
 const inp=document.getElementById("answerInput"); inp.addEventListener("keydown",e=>{if(e.key==="Enter")submitText()}); setTimeout(()=>inp.focus(),50);
}
function renderDrag(q,box){
 const tiles=shuffle(q.items); box.innerHTML=`<div class="tag">DRAG CHALLENGE</div><h2>${q.prompt}</h2><div class="dragarea"><div><small style="color:var(--muted)">Drag tiles into the target order.</small><div class="slots" id="slots"></div></div><div class="tiles" id="tiles">${tiles.map((x,i)=>`<div class="tile" draggable="true" data-value="${x}">${x}</div>`).join("")}</div><button class="btn" onclick="submitDrag()">ACCELERATE</button><div class="feedback" id="feedback"></div></div>`;
 const tilesEl=[...document.querySelectorAll(".tile")]; let dragged=null;
 tilesEl.forEach(t=>{
   t.addEventListener("dragstart",()=>dragged=t);
   t.addEventListener("dragend",()=>dragged=null);
 });
 const slots=document.getElementById("slots");
 slots.addEventListener("dragover",e=>e.preventDefault());
 slots.addEventListener("drop",e=>{e.preventDefault();if(dragged){slots.appendChild(dragged);}});
}
function answerChoice(btn,value){
 if(qLocked)return; const q=raceQuestions[raceIndex];
 qLocked=true; [...btn.parentElement.children].forEach(x=>x.disabled=true);
 const ok=norm(value)===norm(q.answer); resolveAnswer(ok,btn);
}
function submitText(){
 if(qLocked)return; const q=raceQuestions[raceIndex], input=document.getElementById("answerInput");
 const value=input.value; if(!value.trim())return;
 qLocked=true; const ok=(q.answer instanceof Array?q.answer:norm(q.answer)===norm(value)) && !(q.answer instanceof Array);
 resolveAnswer(ok,input);
}
function submitDrag(){
 if(qLocked)return;
 const q=raceQuestions[raceIndex], vals=[...document.querySelectorAll("#slots .tile")].map(x=>x.dataset.value);
 qLocked=true; resolveAnswer(JSON.stringify(vals)===JSON.stringify(q.answer),document.getElementById("slots"));
}
function resolveAnswer(ok,el){
 answered++;
 const fb=document.getElementById("feedback");
 if(ok){
   correct++; combo++;
   const turbo=1+Math.min(combo,5)*.12;
   const boost=38*turbo;
   speed=Math.min(280,speed+boost);
   raceScore+=100*Math.round(turbo*10)/10;
   fb.className="feedback good";fb.textContent=`CORRECT — ACCELERATION +${Math.round(boost)} km/h • TURBO x${(turbo).toFixed(2)}`;
   flash(`+${Math.round(boost)} KM/H`,false);
 }else{
   combo=0; speed=Math.max(45,speed-42); raceScore=Math.max(0,raceScore-25);
   fb.className="feedback bad";fb.textContent="INCORRECT — BRAKE PENALTY −42 km/h";
   flash("BRAKE −42",true);
 }
 setTimeout(()=>{raceIndex++; if(raceIndex>=raceQuestions.length){document.getElementById("questionBox").style.display="none";return} openQuestion()},700);
}
function flash(txt,red){
 const d=document.createElement("div");d.className="boost"+(red?" red":"");d.textContent=txt;document.getElementById("trackwrap").appendChild(d);setTimeout(()=>d.remove(),800);
}
function finishRace(){
 if(!running)return; running=false; cancelAnimationFrame(animId);
 document.getElementById("questionBox").style.display="none";
 const all=[playerDist,...aiDist].map((d,i)=>({d,i})).sort((a,b)=>b.d-a.d);
 const pos=all.findIndex(x=>x.i===0)+1;
 const acc=answered?Math.round(correct/answered*100):0;
 raceScore+=Math.max(0,Math.round(1000-Math.abs(1000-playerDist)));
 if(pos===1)raceScore+=300; else if(pos===2)raceScore+=180; else if(pos===3)raceScore+=80;
 raceState.score+=raceScore;raceState.races++;raceState.best=Math.max(raceState.best,raceScore);saveRace();
 document.getElementById("topScore").textContent=raceState.score;document.getElementById("topRaces").textContent=raceState.races;document.getElementById("topBest").textContent=raceState.best;
 document.getElementById("rPos").textContent=`${pos} / 4`;document.getElementById("rScore").textContent=raceScore;document.getElementById("rAcc").textContent=acc+"%";document.getElementById("rSpeed").textContent=Math.round(maxSpeed)+" km/h";
 document.getElementById("resultTitle").textContent=pos===1?"P1 — FINISH LINE":"RACE COMPLETE";
 document.getElementById("resultMessage").textContent=`${missions[selectedMission-1].title} • ${correct}/${answered} correct • ${Math.round(raceTimer)} seconds`;
 show("result");
}
document.getElementById("topScore").textContent=raceState.score;
document.getElementById("topRaces").textContent=raceState.races;
document.getElementById("topBest").textContent=raceState.best;
renderMissionList();
</script>
