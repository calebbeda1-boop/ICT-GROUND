<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Data Representation Racing — Year 10</title>
<style>
:root{
 --bg:#050a10;--panel:#0b131d;--panel2:#101c29;--line:#24384a;--text:#edf5fa;
 --muted:#8ea4b5;--cyan:#32d6ff;--green:#59e6a8;--red:#ff5e68;--gold:#ffd166;
}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 50% -10%,#17344a,#050a10 48%);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif}
button,input{font:inherit}button{cursor:pointer}
.top{height:66px;border-bottom:1px solid var(--line);background:#050b12e8;display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}
.logo{font-weight:900;letter-spacing:1.7px;font-size:13px}.logo b{color:var(--cyan)}
.stats{display:flex;gap:22px;font-size:12px;color:var(--muted)}.stats b{color:var(--text)}
.screen{display:none;max-width:1220px;margin:auto;padding:42px 24px}.screen.active{display:block}
.panel{background:linear-gradient(145deg,#0d1823,#09111a);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 60px #0007}
.hero{padding:46px;text-align:center}.eyebrow{color:var(--cyan);font-size:11px;font-weight:900;letter-spacing:2px}.hero h1{font-size:clamp(34px,6vw,68px);margin:10px 0 5px;letter-spacing:-2px}.hero p{color:var(--muted);max-width:720px;margin:0 auto 28px;line-height:1.6}
.btn{border:1px solid var(--cyan);background:#0b2936;color:#eafaff;padding:13px 20px;border-radius:9px;font-weight:800}.btn:hover{background:#103b4c}.btn.secondary{border-color:var(--line);background:#0b141e}
.setup{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}.setup .panel{padding:22px}.setup h3{margin:0 0 14px}.mission-list{display:grid;gap:8px}.mission-btn{padding:13px;text-align:left;border:1px solid var(--line);border-radius:9px;background:#0a131c;color:var(--text)}.mission-btn.selected{border-color:var(--cyan);box-shadow:0 0 0 1px #32d6ff33 inset}.mission-btn small{display:block;color:var(--muted);margin-top:4px}
.mode{display:flex;gap:8px;flex-wrap:wrap}.mode button{flex:1;min-width:130px;padding:13px;border:1px solid var(--line);background:#0a131c;color:var(--text);border-radius:9px}.mode button.selected{border-color:var(--gold);color:var(--gold)}
#race{padding:18px;max-width:1450px}
.racehud{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:9px;margin-bottom:12px}.metric{padding:12px 14px}.metric span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px}.metric b{font-size:20px}.metric .cyan{color:var(--cyan)}.metric .gold{color:var(--gold)}
.trackwrap{position:relative;height:570px;overflow:hidden;border:1px solid #324657;border-radius:14px;background:#111820}
.track{position:absolute;inset:0;overflow:hidden;background:
 linear-gradient(90deg,#17211a 0 9%,#252c30 9% 91%,#17211a 91% 100%);
}
.road{position:absolute;left:9%;right:9%;top:0;bottom:0;background:repeating-linear-gradient(to bottom,#252a2e 0 55px,#292f33 55px 110px);transform:translateY(0)}
.road:before,.road:after{content:"";position:absolute;top:0;bottom:0;width:5px;background:repeating-linear-gradient(to bottom,#f3f5f5 0 34px,transparent 34px 68px);opacity:.75}.road:before{left:33.333%}.road:after{left:66.666%}
.edge{position:absolute;top:0;bottom:0;width:9%;background:repeating-linear-gradient(to bottom,#bd2630 0 34px,#f0eee9 34px 68px)}.edge.left{left:0}.edge.right{right:0}
.grass{position:absolute;inset:0;background:linear-gradient(90deg,#142019,#20272a 9%,transparent 9% 91%,#20272a 91%,#142019)}
.car{position:absolute;width:46px;height:78px;border-radius:15px 15px 10px 10px;z-index:8;transform:translateX(-50%);box-shadow:0 7px 18px #000b}
.car:before{content:"";position:absolute;left:7px;right:7px;top:11px;height:22px;border-radius:8px;background:#dbe8ef33;border:1px solid #ffffff33}.car:after{content:"";position:absolute;left:8px;right:8px;bottom:8px;height:8px;background:#05070a;border-radius:3px}
.player{background:linear-gradient(#43dcff,#087fa7);border:2px solid #8aeaff}.ai1{background:linear-gradient(#ffb84d,#a85109);border:2px solid #ffe0a0}.ai2{background:linear-gradient(#ff6872,#8e1f2b);border:2px solid #ffb0b5}.ai3{background:linear-gradient(#b58cff,#5c37a9);border:2px solid #d7c8ff}
.nameplate{position:absolute;top:-18px;left:50%;transform:translateX(-50%);font-size:8px;white-space:nowrap;font-weight:900;letter-spacing:.5px}
.question{position:absolute;z-index:15;left:50%;top:50%;transform:translate(-50%,-50%);width:min(760px,92%);max-height:90%;overflow:auto;padding:25px;background:#07111bf2;border:1px solid #456276;border-radius:15px;box-shadow:0 25px 80px #000c;backdrop-filter:blur(12px)}
.question .tag{font-size:10px;color:var(--cyan);font-weight:900;letter-spacing:1.5px}.question h2{font-size:22px;line-height:1.35;margin:10px 0 18px}.options{display:grid;grid-template-columns:1fr 1fr;gap:9px}.option{padding:14px;text-align:left;background:#0b1823;color:var(--text);border:1px solid var(--line);border-radius:9px}.option:hover{border-color:#6b879a}.option.correct{border-color:var(--green);background:#0d2c23}.option.wrong{border-color:var(--red);background:#35171b}
.typebox{display:flex;gap:9px}.typebox input{flex:1;padding:14px;background:#07111a;border:1px solid var(--line);color:var(--text);border-radius:9px;outline:none}.typebox input:focus{border-color:var(--cyan)}
.dragarea{display:grid;gap:12px}.slots{display:flex;gap:7px;flex-wrap:wrap;min-height:52px;padding:8px;border:1px dashed #496172;border-radius:9px}.slot{min-width:75px;min-height:36px;border:1px dashed #516b7d;border-radius:7px;display:grid;place-items:center;color:#718b9b;font-size:12px}.tile{padding:11px 15px;border:1px solid #486275;border-radius:8px;background:#10202d;cursor:grab;font-weight:800}.tiles{display:flex;gap:7px;flex-wrap:wrap}
.feedback{min-height:25px;margin-top:12px;font-weight:900}.good{color:var(--green)}.bad{color:var(--red)}
.boost{position:absolute;z-index:14;left:50%;top:36%;transform:translate(-50%,-50%);font-size:31px;font-weight:1000;color:var(--gold);text-shadow:0 4px 18px #000;animation:pop .8s ease forwards;pointer-events:none}.boost.red{color:var(--red)}@keyframes pop{0%{opacity:0;transform:translate(-50%,-30%) scale(.7)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.1)}100%{opacity:0;transform:translate(-50%,-80%) scale(1)}}
.progress{height:8px;background:#071019;border-radius:99px;overflow:hidden;border:1px solid var(--line)}.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--green));width:0}
.countdown{position:absolute;z-index:30;inset:0;display:grid;place-items:center;background:#02060ab8;font-size:100px;font-weight:1000;color:white;text-shadow:0 0 35px var(--cyan)}
.result{padding:38px;text-align:center}.result h1{font-size:42px}.resultgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:25px 0}.resultgrid .metric{padding:20px}
.instructions{margin-top:15px;color:var(--muted);font-size:12px;line-height:1.6}
@media(max-width:850px){.setup,.racehud,.resultgrid{grid-template-columns:1fr 1fr}.options{grid-template-columns:1fr}.trackwrap{height:500px}.hero{padding:30px 18px}.stats{gap:9px}.top{padding:0 12px}}
@media(max-width:520px){.setup,.racehud,.resultgrid{grid-template-columns:1fr}.topstats span{display:none}.question h2{font-size:18px}}
</style>
</head>
<body>
<header class="top">
 <div class="logo">DATA REPRESENTATION <b>RACING</b> // YEAR 10</div>
 <div class="stats"><span>SCORE <b id="topScore">0</b></span><span>RACES <b id="topRaces">0</b></span><span>BEST <b id="topBest">0</b></span></div>
</header>

<section id="home" class="screen active">
 <div class="hero panel">
  <div class="eyebrow">IGCSE COMPUTER SCIENCE 0478</div>
  <h1>DATA REPRESENTATION<br><span style="color:var(--cyan)">RACING</span></h1>
  <p>Race against AI riders while solving Data Representation challenges. Correct answers accelerate your bike. Build a combo to trigger TURBO and take the lead.</p>
  <button class="btn" onclick="showSetup()">ENTER THE GRID</button>
  <div class="instructions"><b>Controls:</b> Click the correct answer • Type the correct value • Drag tiles into the correct order.<br>Correct = acceleration boost • Wrong = speed penalty • Consecutive correct answers = turbo multiplier.</div>
 </div>
</section>

<section id="setup" class="screen">
 <div class="panel" style="padding:25px">
  <div class="eyebrow">RACE CONFIGURATION</div>
  <h2>Choose your race</h2>
  <div class="setup">
   <div class="panel" style="padding:18px">
    <h3>Topic</h3><div id="missionList" class="mission-list"></div>
   </div>
   <div class="panel" style="padding:18px">
    <h3>Race Length</h3>
    <div class="mode">
      <button id="m5" class="selected" onclick="setMode(5)">SPRINT<br><small>5 questions</small></button>
      <button id="m10" onclick="setMode(10)">GRAND PRIX<br><small>10 questions</small></button>
    </div>
    <p class="instructions">Every race samples a different set of questions from the selected topic. Some races include calculation, concept and application questions.</p>
    <button class="btn" style="width:100%;margin-top:15px" onclick="startRace()">START RACE</button>
    <button class="btn secondary" style="width:100%;margin-top:8px" onclick="show('home')">BACK</button>
   </div>
  </div>
 </div>
</section>

<section id="race" class="screen">
 <div class="racehud">
  <div class="metric panel"><span>Speed</span><b><span id="speed">0</span> km/h</b></div>
  <div class="metric panel"><span>Position</span><b id="position">4 / 4</b></div>
  <div class="metric panel"><span>Combo</span><b class="gold">x<span id="combo">0</span></b></div>
  <div class="metric panel"><span>Question</span><b id="qnum">1 / 5</b></div>
 </div>
 <div class="panel" style="padding:8px 10px;margin-bottom:10px"><div class="progress"><i id="raceProgress"></i></div></div>
 <div id="trackwrap" class="trackwrap">
  <div class="countdown" id="countdown">3</div>
  <div class="grass"></div><div class="edge left"></div><div class="edge right"></div><div class="road" id="road"></div>
  <div id="bikePlayer" class="car player" style="left:50%;bottom:55px"><span class="nameplate">YOU</span></div>
  <div id="bike1" class="car ai1" style="left:27%;bottom:185px"><span class="nameplate">AI 01</span></div>
  <div id="bike2" class="car ai2" style="left:61%;bottom:280px"><span class="nameplate">AI 02</span></div>
  <div id="bike3" class="car ai3" style="left:76%;bottom:105px"><span class="nameplate">AI 03</span></div>
  <div id="questionBox" class="question" style="display:none"></div>
 </div>
</section>

<section id="result" class="screen">
 <div class="result panel">
  <div class="eyebrow">FINISH LINE</div><h1 id="resultTitle">RACE COMPLETE</h1>
  <p id="resultMessage" style="color:var(--muted)"></p>
  <div class="resultgrid">
   <div class="metric panel"><span>Finish</span><b id="rPos">—</b></div>
   <div class="metric panel"><span>Score</span><b id="rScore">0</b></div>
   <div class="metric panel"><span>Accuracy</span><b id="rAcc">0%</b></div>
   <div class="metric panel"><span>Max Speed</span><b id="rSpeed">0</b></div>
  </div>
  <button class="btn" onclick="showSetup()">RACE AGAIN</button>
  <button class="btn secondary" onclick="show('home')">MAIN MENU</button>
 </div>
</section>

<script>
const missions=[
{id:1,title:"Number Systems",desc:"Binary place values, denary-to-binary and binary-to-denary conversion.",tags:["Binary","Denary","8-bit"]},
{id:2,title:"Hexadecimal",desc:"Convert between binary, hexadecimal and denary and identify practical uses of hexadecimal.",tags:["Hex","4-bit groups","Byte"]},
{id:3,title:"Binary Addition & Overflow",desc:"Perform binary addition and identify overflow in 8-bit unsigned values.",tags:["Addition","8-bit","Overflow"]},
{id:4,title:"Logical Shifts",desc:"Apply logical left and right shifts and determine the numerical effect.",tags:["Left shift","Right shift"]},
{id:5,title:"Two's Complement",desc:"Represent negative numbers and interpret 8-bit two's complement values.",tags:["Signed binary","Negative values"]},
{id:6,title:"Text Representation",desc:"Apply ASCII and Unicode concepts to characters, symbols and languages.",tags:["ASCII","Unicode"]},
{id:7,title:"Sound Representation",desc:"Apply sample rate, sample resolution and sound file-size calculations.",tags:["Sample rate","Sample resolution","File size"]},
{id:8,title:"Image Representation",desc:"Apply resolution, colour depth and image file-size calculations.",tags:["Pixels","Colour depth","File size"]},
{id:9,title:"Storage & File Size",desc:"Convert between bits, bytes and binary storage units and solve storage scenarios.",tags:["Bits","Bytes","KiB","MiB","GiB"]},
{id:10,title:"Compression",desc:"Explain compression and distinguish lossless from lossy compression.",tags:["Lossless","Lossy","File size"]},
{id:11,title:"RLE Challenge",desc:"Encode and decode repeated data using run-length encoding.",tags:["RLE","Encoding","Decoding"]},
{id:12,title:"Integrated Data Challenge",desc:"Apply mixed Data Representation skills in realistic technical scenarios.",tags:["Mixed","Application","IGCSE style"]}
];

/* LARGE QUESTION BANK
   The pools below deliberately contain many generated variants.
   The game samples 5 questions from the relevant pool each session.
*/
const Q={};

function q(type,prompt,answer,extra={}){return {type,prompt,answer,...extra};}
function choice(prompt,answer,options){return q("choice",prompt,answer,{options});}
function text(prompt,answer){return q("text",prompt,answer)}
function bitq(prompt,answer){return q("bits",prompt,answer)}

function bin8(n){return n.toString(2).padStart(8,"0")}
function hex2(n){return n.toString(16).toUpperCase().padStart(2,"0")}
function pop(arr){return arr[Math.floor(Math.random()*arr.length)]}
function uniquePool(arr){return [...arr]}

/* Mission 1 — 30+ */
Q[1]=[];
[5,9,12,18,25,31,42,47,55,64,73,85,96,100,111,120,127,128,137,145,150,160,173,180,192,200,210,225,240,255].forEach(n=>{
 Q[1].push(bitq(`Convert ${n} denary into an 8-bit binary value.`,bin8(n)));
});
[["00000101",5],["00001010",10],["00011111",31],["00110010",50],["01010101",85],["01100100",100],["01111111",127],["10000000",128],["10011010",154],["10101101",173],["11001000",200],["11110000",240]].forEach(x=>Q[1].push(text(`Convert ${x[0]} from binary to denary.`,String(x[1]))));
[2,3,4,5,6,7,8,10].forEach(n=>Q[1].push(choice(`How many different values can ${n} bits represent?`,String(2**n),[String(2**n),String(2**n-1),String(n*2),String(n+2)])));
Q[1].push(
choice("What is the largest unsigned value that can be stored in 8 bits?","255",["127","128","255","256"]),
choice("Which number system uses only the digits 0 and 1?","Binary",["Binary","Denary","Hexadecimal","ASCII"]),
choice("What is the 8-bit place value of the leftmost bit?","128",["64","128","255","256"])
);

/* Mission 2 — 25+ */
Q[2]=[];
[0,15,16,26,31,32,45,64,75,90,127,128,154,160,173,180,192,200,205,220,240,255].forEach(n=>{
 Q[2].push(text(`Convert ${n} denary to two-digit hexadecimal.`,hex2(n)));
});
[["0A",10],["1F",31],["2C",44],["40",64],["55",85],["64",100],["7F",127],["80",128],["9C",156],["A5",165],["BD",189],["C8",200],["F0",240],["FF",255]].forEach(x=>Q[2].push(text(`Convert hexadecimal ${x[0]} to denary.`,String(x[1]))));
[
["1010 1101","AD"],["1111 0000","F0"],["0101 1010","5A"],["1001 1100","9C"],["0011 0011","33"],["1111 1111","FF"],["0110 0100","64"],["1011 1101","BD"]
].forEach(x=>Q[2].push(text(`Convert binary ${x[0]} to hexadecimal.`,x[1])));
Q[2].push(
choice("How many bits are represented by one hexadecimal digit?","4",["2","4","8","16"]),
choice("How many hexadecimal digits represent one byte?","2",["1","2","4","8"]),
choice("Which is a common use of hexadecimal?","HTML/CSS colour codes",["Typing long paragraphs","HTML/CSS colour codes","Sound sampling only","Keyboard layout only"]),
choice("Why is hexadecimal useful compared with binary?","It is more compact and easier for humans to read",["It uses no bits","It is more compact and easier for humans to read","It stores more than 8 bits automatically","It removes the need for binary"])
);

/* Mission 3 — 25+ */
Q[3]=[];
[[5,3],[12,7],[25,14],[42,21],[64,31],[73,19],[85,42],[96,27],[100,55],[120,35],[127,1],[128,64],[137,55],[150,25],[160,70],[173,42],[180,30],[192,63],[200,50],[210,20]].forEach(([a,b])=>{
 const s=a+b; Q[3].push(text(`Add ${bin8(a)} + ${bin8(b)} using 8-bit binary. Give the 8-bit result.`,bin8(s%256)));
});
[[200,55],[210,60],[230,40],[240,20],[250,10],[180,100],[200,100],[255,1],[150,120]].forEach(([a,b])=>{
 const s=a+b; Q[3].push(choice(`Calculate ${a} + ${b} in an 8-bit unsigned register. Does overflow occur?`,s>255?"Yes":"No",["Yes","No"]));
});
Q[3].push(
choice("What is overflow in an 8-bit unsigned calculation?","The result requires more than 8 bits",["The result contains no zeros","The result requires more than 8 bits","The computer has no memory","The answer is negative"]),
choice("What is the maximum unsigned value in 8 bits?","255",["127","255","256","512"]),
choice("What happens to a 9-bit result when only an 8-bit register is available?","The extra bit cannot be represented in the 8-bit result",["The computer creates a new byte automatically","The extra bit cannot be represented in the 8-bit result","The result becomes hexadecimal","The result becomes a sound file"])
);

/* Mission 4 — 22+ */
Q[4]=[];
[3,5,7,9,12,13,16,20,24,25,32,40,50,64,80,100,120].forEach(n=>{
 const left=n*2;
 if(left<256) Q[4].push(text(`Apply one logical left shift to ${bin8(n)}. Give the 8-bit result.`,bin8(left)));
 const right=Math.floor(n/2);
 Q[4].push(text(`Apply one logical right shift to ${bin8(n)}. Give the 8-bit result.`,bin8(right)));
});
Q[4].push(
choice("A logical left shift by one place is equivalent to multiplying an unsigned binary value by:","2",["2","4","8","10"]),
choice("A logical right shift by one place is equivalent to dividing an unsigned binary value by:","2",["2","4","8","10"]),
choice("What enters the right side during a logical left shift?","0",["0","1","The MSB","The LSB"]),
choice("What enters the left side during a logical right shift?","0",["0","1","The MSB","The LSB"]),
choice("What can happen to the bit shifted out of the register?","It is lost",["It is duplicated","It is stored as hexadecimal","It is lost","It becomes Unicode"])
);

/* Mission 5 — 22+ */
Q[5]=[];
[1,2,3,5,7,8,10,12,15,16,18,20,25,30,32,40,50,63,64,75,100,127].forEach(n=>{
 const pos=bin8(n), inv=pos.split("").map(c=>c==="0"?"1":"0").join("");
 let tc=(parseInt(inv,2)+1)&255;
 Q[5].push(text(`Using 8-bit two's complement, represent −${n}.`,bin8(tc)));
});
[["11100111",-25],["11111111",-1],["10000000",-128],["01111111",127],["11110000",-16],["11101011",-21]].forEach(x=>Q[5].push(text(`Interpret ${x[0]} as an 8-bit two's complement value.`,String(x[1]))));
Q[5].push(
choice("What is the range of 8-bit two's complement?","−128 to +127",["−255 to +255","−128 to +127","0 to 255","−127 to +128"]),
choice("What is the most significant bit worth in 8-bit two's complement?","−128",["128","−128","−127","255"]),
choice("What is the first step when converting a positive binary value to its negative two's complement representation?","Write the positive value in binary",["Add 1 immediately","Write the positive value in binary","Convert to hexadecimal","Remove the MSB"])
);

/* Mission 6 — 18+ */
Q[6]=[
choice("How many bits are normally used by standard ASCII?","7",["4","7","8","16"]),
choice("How many characters can 7-bit ASCII represent?","128",["64","128","256","512"]),
choice("What is a major advantage of Unicode over ASCII?","It supports many more characters, languages and symbols",["It uses no storage","It only supports English","It supports many more characters, languages and symbols","It cannot represent emojis"]),
choice("Which character set is designed to support emojis and many writing systems?","Unicode",["ASCII","Unicode","Binary only","RLE"]),
choice("Why does Unicode generally require more bits than basic ASCII?","It represents a much larger set of characters",["It stores images","It represents a much larger set of characters","It compresses sound","It removes binary"]),
choice("Which of these is a character rather than an image?","A letter such as A",["A letter such as A","A photograph","A sound wave","A pixel grid"]),
text("What is the decimal ASCII code for the character A?","65"),
text("What is the decimal ASCII code for the character D?","68"),
text("What is the 8-bit binary representation of ASCII 65?","01000001"),
text("What is the 8-bit binary representation of ASCII 68?","01000100"),
choice("Which requires more bits per character in general?","Unicode",["ASCII","Unicode","Neither always","RLE"]),
choice("ASCII is sufficient for a system that only needs a small basic character set. Which statement is most accurate?","ASCII represents a limited set of characters",["ASCII represents every possible human language","ASCII represents a limited set of characters","ASCII stores photographs","ASCII is a compression method"])
];
["B","C","X","Z","0","1","9","?","@","#"].forEach(ch=>{
 const code=ch.charCodeAt(0); Q[6].push(text(`What is the decimal ASCII code for ${ch}?`,String(code)));
});

/* Mission 7 — 24+ */
Q[7]=[
choice("What is sample rate?","The number of samples taken per second",["The number of bits in each sample","The number of samples taken per second","The number of channels only","The file name"]),
choice("What is sample resolution?","The number of bits used to store each sample",["The number of samples per second","The number of bits used to store each sample","The duration only","The number of speakers"]),
choice("What happens when sample rate increases?","Accuracy and file size increase",["Accuracy decreases","Accuracy and file size increase","File size becomes zero","Only colour depth changes"]),
choice("What happens when sample resolution increases?","Accuracy and file size increase",["Accuracy and file size increase","File size decreases","Sample rate becomes zero","The sound becomes text"]),
choice("What unit is commonly used for sample rate?","Hz",["Bytes","Hz","Pixels","GiB"]),
text("Calculate the sound file size in bits: 8000 Hz × 8 bits × 10 seconds.","640000"),
text("Calculate the sound file size in bits: 16000 Hz × 8 bits × 5 seconds.","640000"),
text("Calculate the sound file size in bits: 44100 Hz × 16 bits × 2 seconds.","1411200"),
text("Calculate the sound file size in bits: 22050 Hz × 8 bits × 4 seconds.","705600"),
text("Calculate the sound file size in bits: 11025 Hz × 8 bits × 10 seconds.","882000"),
choice("Which recording has the higher sample rate: 8000 Hz or 44100 Hz?","44100 Hz",["8000 Hz","44100 Hz","They are equal","Neither"]),
choice("Which recording generally has greater accuracy: 8-bit resolution or 16-bit resolution?","16-bit",["8-bit","16-bit","Both always equal","Neither"]),
choice("If duration stays constant and sample rate doubles, what happens to the uncompressed file size?","It doubles",["It halves","It doubles","It stays unchanged","It becomes four times smaller"])
];
[[4000,8,5],[8000,16,5],[16000,8,10],[22050,16,3],[44100,8,2],[44100,16,1],[48000,16,2],[8000,8,20]].forEach(([r,res,t])=>{
